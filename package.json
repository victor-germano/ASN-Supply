{
  "name": "asn-supply",
  "private": true,
  "version": "0.1.0",
  "description": "ASN Supply — plataforma de e-commerce premium de tênis.",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm -r --parallel --stream run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{md,json}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.4.0",
      "lodash": "^4.18.1",
      "postcss": "^8.5.28",
      "nanoid@3": "^3.3.19",
      "fast-uri": "^3.1.8",
      "js-yaml@4": "^4.3.2",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@5": "^5.0.12",
      "uuid@11": "^11.1.1",
      "qs": "^6.16.0",
      "webpack": "^5.111.1",
      "body-parser@1": "^1.20.8",
      "sharp": "^0.35.5"
    }
  }
}
