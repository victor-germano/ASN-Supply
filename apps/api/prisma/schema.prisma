// Schema de domínio — ASN Supply
// Cobre os módulos: Home, Listagem de Produtos, PDP, Carrinho, Checkout,
// Área do Cliente e Painel Administrativo (v1). Extensões futuras (Lookbook,
// Provador com IA, Comparador) adicionam modelos próprios sem alterar estes.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identidade e acesso
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
  SUPPORT
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  passwordHash     String?
  role             Role      @default(CUSTOMER)
  avatarUrl        String?
  googleId         String?   @unique
  appleId          String?   @unique
  emailVerifiedAt  DateTime?
  /// Celular em E.164 (`+5511999998888`) — normalizado em `normalizeBrazilianMobile`.
  phone            String?
  /// Consentimento (LGPD) para lembretes/ofertas por SMS — opt-in explícito,
  /// nunca marcado por padrão. A data prova quando foi dado.
  marketingOptIn   Boolean   @default(false)
  marketingOptInAt DateTime?
  termsAcceptedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  addresses          Address[]
  orders             Order[]
  reviews            Review[]
  wishlistItems      WishlistItem[]
  cart               Cart?
  passwordResetCodes PasswordResetCode[]
  activities         CustomerActivity[]
  recoveryMessages   RecoveryMessage[]

  @@map("users")
}

/// Código de 6 dígitos de "esqueci a senha" por SMS. Só o hash é guardado;
/// expira em minutos e trava depois de poucas tentativas erradas.
model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("password_reset_codes")
}

enum CustomerActivityType {
  PRODUCT_VIEW
  CART_ADD
}

/// O que um cliente LOGADO viu/escolheu — base do lembrete "sentimos sua
/// falta" (ver `RecoveryReminderService`). Visitante anônimo nunca é rastreado.
model CustomerActivity {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      CustomerActivityType
  createdAt DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("customer_activities")
}

/// Lembretes enviados — garante no máximo um por cliente por janela (ver
/// `RECOVERY_COOLDOWN_DAYS`) e serve de registro do que foi dito a quem.
model RecoveryMessage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productName String
  body        String
  sentAt      DateTime @default(now())

  @@index([userId, sentAt])
  @@map("recovery_messages")
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  recipientName String
  street        String
  number        String
  complement    String?
  neighborhood  String
  city          String
  state         String
  zipCode       String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())

  products Product[]

  @@map("brands")
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  imageUrl String?
  imageAlt String?

  products Product[]

  @@map("categories")
}

model Collection {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String
  coverImageUrl String?
  coverImageAlt String?
  launchedAt    DateTime?
  createdAt     DateTime  @default(now())

  products Product[]

  @@map("collections")
}

enum ProductGender {
  MASCULINO
  FEMININO
  UNISSEX
  INFANTIL
}

model Product {
  id                    String        @id @default(cuid())
  slug                  String        @unique
  name                  String
  description           String
  materials             String[]
  technologies          String[]
  gender                ProductGender @default(UNISSEX)
  priceInCents          Int
  compareAtPriceInCents Int?
  videoUrl              String?
  has360View            Boolean       @default(false)
  isNewArrival          Boolean       @default(false)
  isBestSeller          Boolean       @default(false)
  isPublished           Boolean       @default(false)
  publishedAt           DateTime?
  sizeGuideId           String?
  /// Denormalizado a partir de `reviews` (recalculado a cada review criada/removida) —
  /// evita agregação em toda listagem e permite ordenar "Melhor avaliados" no banco,
  /// com paginação real, em vez de ordenar em memória após buscar tudo.
  averageRating         Float?
  reviewCount           Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  brandId      String
  brand        Brand       @relation(fields: [brandId], references: [id])
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id])
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id])

  images        ProductImage[]
  variants      ProductVariant[]
  reviews       Review[]
  questions     ProductQuestion[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
  lookItems     LookItem[]
  activities    CustomerActivity[]

  @@index([brandId])
  @@index([categoryId])
  @@index([collectionId])
  @@index([isPublished, isNewArrival])
  @@index([priceInCents])
  @@map("products")
}

// "Complete o look" — peças de outras lojas (Shein, AliExpress, Shopee,
// Mercado Livre etc.) curadas manualmente para combinar com o produto,
// exibidas no Provador Digital. De propósito NÃO é uma integração ao vivo
// com essas plataformas: nenhuma delas oferece hoje uma API pública de
// "combinar peça" para um pequeno lojista; AliExpress/Shopee têm programas
// de afiliado que exigem aprovação externa, e Shein não tem API pública
// acessível (só daria via scraping, fora de cotação — violaria os termos
// deles). Curadoria manual, com link real pra cada peça, é o caminho sem
// dependência de acesso de terceiros ainda não obtido — ver
// scripts/add-look-item.ts para cadastrar itens reais.
model LookItem {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  platform    String
  title       String
  imageUrl    String
  priceLabel  String
  externalUrl String
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([productId, position])
  @@map("look_items")
}

model ProductImage {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  alt          String
  width        Int
  height       Int
  position     Int     @default(0)
  isHoverImage Boolean @default(false)
  /// Frame de giro 360° (Product.has360View) — reaproveita esta tabela em vez
  /// de uma dedicada porque é a mesma natureza de dado (imagem + posição),
  /// só ordenado como sequência de rotação em vez de galeria.
  is360Frame   Boolean @default(false)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id                   String  @id @default(cuid())
  productId            String
  product              Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                  String  @unique
  size                 String
  colorName            String
  colorHex             String
  stockQuantity        Int     @default(0)
  priceOverrideInCents Int?

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, colorName])
  @@index([productId])
  @@map("product_variants")
}

model Review {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  rating             Int
  title              String
  comment            String
  imageUrls          String[]
  videoUrls          String[]
  isVerifiedPurchase Boolean  @default(false)
  helpfulCount       Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([productId])
  @@map("reviews")
}

/// Sem FK para User de propósito: o Q&A de produto tradicionalmente exibe só
/// um nome de exibição, não uma conta completa — e o Módulo 5 (autenticação)
/// ainda não existe. Perguntar de fato (não só listar) fica bloqueado até lá.
model ProductQuestion {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  askerName  String
  question   String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([productId])
  @@map("product_questions")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// Carrinho
// ---------------------------------------------------------------------------

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId  String?
  coupon    Coupon?  @relation(fields: [couponId], references: [id])
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  addedAt   DateTime       @default(now())

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  percentageOff    Int?
  amountOffInCents Int?
  minOrderInCents  Int?
  expiresAt        DateTime?
  maxRedemptions   Int?
  redemptionCount  Int       @default(0)
  isActive         Boolean   @default(true)

  carts  Cart[]
  orders Order[]

  @@map("coupons")
}

// ---------------------------------------------------------------------------
// Conteúdo institucional (Home / Marketing)
// ---------------------------------------------------------------------------

model Banner {
  id              String    @id @default(cuid())
  title           String
  subtitle        String?
  ctaLabel        String
  ctaHref         String
  imageUrlDesktop String
  imageUrlMobile  String
  position        Int       @default(0)
  isActive        Boolean   @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([isActive, position])
  @@map("banners")
}

/// Vitrine social exibida na Home. Alimentada manualmente (ou via painel
/// administrativo) até que uma conta Instagram Business seja conectada —
/// nesse ponto, a implementação de SocialPostRepository passa a consultar a
/// Instagram Graph API em vez desta tabela, sem alterar o restante da app.
model SocialPost {
  id        String   @id @default(cuid())
  imageUrl  String
  permalink String
  caption   String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive, position])
  @@map("social_posts")
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@map("newsletter_subscribers")
}

// ---------------------------------------------------------------------------
// Pedido e pagamento
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  PIX
  MERCADO_PAGO
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum ShippingMethod {
  STANDARD
  EXPRESS
}

/// Checkout como convidado (Módulo 4): a Área do Cliente (login) é um módulo
/// posterior, então `userId` é opcional e o contato/endereço de entrega vêm
/// denormalizados diretamente no pedido — sem exigir conta nem referenciar um
/// `Address` salvo. `addressId` fica pronto (não usado ainda) para quando um
/// cliente autenticado puder escolher um endereço salvo no Módulo 5; mesmo
/// nesse caso os campos `shipping*` continuam sendo a cópia autoritativa
/// entregue de fato — um endereço salvo pode ser editado/apagado depois da
/// compra, o pedido não pode mudar retroativamente por causa disso.
model Order {
  id                    String         @id @default(cuid())
  code                  String         @unique
  userId                String?
  user                  User?          @relation(fields: [userId], references: [id])
  guestName             String
  guestEmail            String
  guestPhone            String
  addressId             String?
  address               Address?       @relation(fields: [addressId], references: [id])
  shippingRecipientName String
  shippingStreet        String
  shippingNumber        String
  shippingComplement    String?
  shippingNeighborhood  String
  shippingCity          String
  shippingState         String
  shippingZipCode       String
  shippingMethod        ShippingMethod @default(STANDARD)
  status                OrderStatus    @default(PENDING_PAYMENT)
  subtotalInCents       Int
  shippingCostInCents   Int
  discountInCents       Int            @default(0)
  totalInCents          Int
  couponId              String?
  coupon                Coupon?        @relation(fields: [couponId], references: [id])
  installments          Int            @default(1)
  createdAt             DateTime       @default(now())
  estimatedDeliveryAt   DateTime?
  // Rastreio — preenchido manualmente pelo admin (Painel Admin, Módulo 6);
  // sem integração com transportadora real ainda (nenhuma API de Correios/
  // Melhor Envio configurada), mesmo espírito de `calculateShippingCostInCents`
  // (tabela fixa) e `NullPaymentGateway`: base pronta, integração real depois
  // troca só o adapter, não o schema nem o resto do fluxo.
  trackingCode          String?
  trackingUrl           String?

  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([guestEmail])
  @@map("orders")
}

/// Snapshot de nome/imagem/tamanho/cor no momento da compra — deliberadamente
/// redundante com `Product`/`ProductVariant`: um pedido de meses atrás precisa
/// mostrar o que foi de fato comprado, mesmo que o produto seja renomeado,
/// tenha as fotos trocadas ou (por Restrict na FK) nunca possa ser apagado.
model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Nulos depois que o produto/variante é excluído ou editado no admin —
  /// o pedido continua íntegro pela cópia abaixo (nome, slug, imagem,
  /// tamanho, cor, preço no momento da compra). Sem `SetNull`, um único
  /// pedido travava para sempre a edição e a exclusão do produto.
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName      String
  productSlug      String
  imageUrl         String
  size             String
  colorName        String
  quantity         Int
  unitPriceInCents Int

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  providerReference String?
  rawPayload        Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("payments")
}

/// Imagens enviadas pelo painel quando não há Cloudinary configurada (ver
/// `DatabaseImageUploader`). Ficam no banco porque o disco de uma
/// hospedagem é apagado a cada deploy. Sem relação com Product/Brand: a URL
/// é só um texto no catálogo, como qualquer outra.
model StoredImage {
  id          String   @id @default(uuid())
  contentType String
  data        Bytes
  width       Int
  height      Int
  createdAt   DateTime @default(now())

  @@map("stored_images")
}
