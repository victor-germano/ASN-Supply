// Schema de domínio — ASN Supply
// Cobre os módulos: Home, Listagem de Produtos, PDP, Carrinho, Checkout,
// Área do Cliente e Painel Administrativo (v1). Extensões futuras (Lookbook,
// Provador com IA, Comparador) adicionam modelos próprios sem alterar estes.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identidade e acesso
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
  SUPPORT
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  avatarUrl     String?
  googleId      String?   @unique
  appleId       String?   @unique
  emailVerifiedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  cart          Cart?

  @@map("users")
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String
  recipientName String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  isDefault    Boolean @default(false)
  createdAt    DateTime @default(now())

  orders       Order[]

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  createdAt DateTime  @default(now())

  products  Product[]

  @@map("brands")
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")
  imageUrl  String?
  imageAlt  String?

  products  Product[]

  @@map("categories")
}

model Collection {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String
  coverImageUrl String?
  coverImageAlt String?
  launchedAt    DateTime?
  createdAt     DateTime  @default(now())

  products    Product[]

  @@map("collections")
}

enum ProductGender {
  MASCULINO
  FEMININO
  UNISSEX
  INFANTIL
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  description    String
  materials      String[]
  technologies   String[]
  gender         ProductGender @default(UNISSEX)
  priceInCents   Int
  compareAtPriceInCents Int?
  videoUrl       String?
  has360View     Boolean       @default(false)
  isNewArrival   Boolean       @default(false)
  isBestSeller   Boolean       @default(false)
  isPublished    Boolean       @default(false)
  publishedAt    DateTime?
  sizeGuideId    String?
  /// Denormalizado a partir de `reviews` (recalculado a cada review criada/removida) —
  /// evita agregação em toda listagem e permite ordenar "Melhor avaliados" no banco,
  /// com paginação real, em vez de ordenar em memória após buscar tudo.
  averageRating  Float?
  reviewCount    Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  brandId        String
  brand          Brand         @relation(fields: [brandId], references: [id])
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  collectionId   String?
  collection     Collection?   @relation(fields: [collectionId], references: [id])

  images         ProductImage[]
  variants       ProductVariant[]
  reviews        Review[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  cartItems      CartItem[]

  @@index([brandId])
  @@index([categoryId])
  @@index([collectionId])
  @@index([isPublished, isNewArrival])
  @@index([priceInCents])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  width     Int
  height    Int
  position  Int     @default(0)
  isHoverImage Boolean @default(false)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String  @unique
  size           String
  colorName      String
  colorHex       String
  stockQuantity  Int     @default(0)
  priceOverrideInCents Int?

  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@unique([productId, size, colorName])
  @@index([productId])
  @@map("product_variants")
}

model Review {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  rating             Int
  title              String
  comment            String
  imageUrls          String[]
  videoUrls          String[]
  isVerifiedPurchase Boolean  @default(false)
  helpfulCount       Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([productId])
  @@map("reviews")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// Carrinho
// ---------------------------------------------------------------------------

model Cart {
  id         String     @id @default(cuid())
  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId   String?
  coupon     Coupon?    @relation(fields: [couponId], references: [id])
  updatedAt  DateTime   @updatedAt

  items      CartItem[]

  @@map("carts")
}

model CartItem {
  id         String         @id @default(cuid())
  cartId     String
  cart       Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  String
  product    Product        @relation(fields: [productId], references: [id])
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int            @default(1)
  addedAt    DateTime       @default(now())

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  percentageOff    Int?
  amountOffInCents Int?
  minOrderInCents  Int?
  expiresAt        DateTime?
  maxRedemptions    Int?
  redemptionCount   Int       @default(0)
  isActive          Boolean   @default(true)

  carts            Cart[]
  orders           Order[]

  @@map("coupons")
}

// ---------------------------------------------------------------------------
// Conteúdo institucional (Home / Marketing)
// ---------------------------------------------------------------------------

model Banner {
  id             String    @id @default(cuid())
  title          String
  subtitle       String?
  ctaLabel       String
  ctaHref        String
  imageUrlDesktop String
  imageUrlMobile String
  position       Int       @default(0)
  isActive       Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([isActive, position])
  @@map("banners")
}

/// Vitrine social exibida na Home. Alimentada manualmente (ou via painel
/// administrativo) até que uma conta Instagram Business seja conectada —
/// nesse ponto, a implementação de SocialPostRepository passa a consultar a
/// Instagram Graph API em vez desta tabela, sem alterar o restante da app.
model SocialPost {
  id         String   @id @default(cuid())
  imageUrl   String
  permalink  String
  caption    String?
  position   Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([isActive, position])
  @@map("social_posts")
}

model NewsletterSubscriber {
  id            String    @id @default(cuid())
  email         String    @unique
  subscribedAt  DateTime  @default(now())
  unsubscribedAt DateTime?

  @@map("newsletter_subscribers")
}

// ---------------------------------------------------------------------------
// Pedido e pagamento
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  PIX
  MERCADO_PAGO
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

model Order {
  id                 String        @id @default(cuid())
  code               String        @unique
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  addressId          String
  address            Address       @relation(fields: [addressId], references: [id])
  status             OrderStatus   @default(PENDING_PAYMENT)
  subtotalInCents    Int
  shippingCostInCents Int
  discountInCents    Int           @default(0)
  totalInCents       Int
  couponId           String?
  coupon             Coupon?       @relation(fields: [couponId], references: [id])
  installments       Int           @default(1)
  createdAt          DateTime      @default(now())
  estimatedDeliveryAt DateTime?

  items              OrderItem[]
  payment            Payment?

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id                String         @id @default(cuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product        @relation(fields: [productId], references: [id])
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id])
  quantity          Int
  unitPriceInCents  Int

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  providerReference String?
  rawPayload        Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("payments")
}
