# Ambiente
NODE_ENV=development
PORT=3400
CORS_ALLOWED_ORIGINS=http://localhost:3100

# Banco de dados (docker-compose na raiz sobe um Postgres local)
DATABASE_URL=postgresql://asn:asn@localhost:5432/asn_supply?schema=public

# Cache / filas
REDIS_URL=redis://localhost:6379

# Autenticação
JWT_SECRET=troque-este-valor-por-um-segredo-forte-de-32-chars-ou-mais
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Login social — sem as duas primeiras, o botão "Continuar com Google" no
# site nem aparece (ver NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED em apps/web) e
# GET /auth/google responde 503 explícito em vez de tentar um redirect com
# credencial falsa. Crie um "OAuth client ID" tipo "Web application" no
# Google Cloud Console (console.cloud.google.com/apis/credentials),
# cadastrando GOOGLE_OAUTH_CALLBACK_URL como "Authorized redirect URI"
# exatamente igual (protocolo, host e porta) — em produção, troque o
# default de dev por https://sua-api.com/v1/auth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3400/v1/auth/google/callback
APPLE_OAUTH_CLIENT_ID=

# Pagamentos
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADO_PAGO_ACCESS_TOKEN=

# Upload de imagem no painel admin (marca/categoria/coleção/produto) —
# sem ela, POST /admin/uploads responde 503 e o formulário cai no campo
# de URL colada, que sempre funcionou (ver ImageUploader). Crie uma conta
# grátis em cloudinary.com — o "Product Environment Credentials URL" do
# dashboard já vem pronto no formato certo (cloudinary://key:secret@cloud).
CLOUDINARY_URL=
# Reservadas — alternativa a Cloudinary nunca implementada.
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# IA (Provador Inteligente — Módulo 7)
ANTHROPIC_API_KEY=

# E-mail transacional (reset de senha, verificação de e-mail, confirmação
# de pedido). Escolha UM provedor — prioridade: Resend → SMTP → console.
# Sem nenhum, os e-mails só aparecem logados no console da API
# (ConsoleEmailSender) — útil para testar o fluxo em dev.
#
# Opção A — Gmail (recomendado enquanto não houver domínio próprio):
#   1. Na conta Google, ative a verificação em duas etapas.
#   2. Gere uma "senha de app" em https://myaccount.google.com/apppasswords
#   3. Preencha SMTP_USER com o Gmail e SMTP_PASS com a senha de app
#      (16 letras, sem espaços). EMAIL_FROM pode ficar vazio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
#
# Opção B — Resend (quando tiver domínio verificado em resend.com).
RESEND_API_KEY=
EMAIL_FROM=
WEB_APP_URL=http://localhost:3100

# Observability — sem SENTRY_DSN, o SDK simplesmente não envia nada
# (comportamento padrão dele). Crie um projeto Node/NestJS grátis em
# sentry.io e cole o DSN aqui quando quiser rastrear erros de produção.
SENTRY_DSN=

# LEGADO — não usada mais. O acesso administrativo agora é Role.ADMIN +
# JWT (mesmo login de cliente, ver /admin/entrar no site), não bearer
# token fixo. Mantida só porque apps/api/src/modules/admin/ não pôde ser
# apagada nesta sessão (sandbox negou); pode remover a pasta e esta linha
# juntas sem medo.
ADMIN_API_KEY=
