# Ambiente
NODE_ENV=development
PORT=3333
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Banco de dados (docker-compose na raiz sobe um Postgres local)
DATABASE_URL=postgresql://asn:asn@localhost:5432/asn_supply?schema=public

# Cache / filas
REDIS_URL=redis://localhost:6379

# Autenticação
JWT_SECRET=troque-este-valor-por-um-segredo-forte-de-32-chars-ou-mais
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=

# Pagamentos
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADO_PAGO_ACCESS_TOKEN=

# Mídia
CLOUDINARY_URL=
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# IA (Provador Inteligente — Módulo 7)
ANTHROPIC_API_KEY=

# E-mail transacional (reset de senha, verificação de e-mail, confirmação
# de pedido). Sem RESEND_API_KEY, os e-mails só aparecem logados no
# console da API (ConsoleEmailSender) — útil para testar o fluxo em dev
# sem depender de conta no Resend. Crie uma conta grátis em resend.com,
# gere uma API key, e troque EMAIL_FROM por um remetente verificado seu.
RESEND_API_KEY=
EMAIL_FROM=ASN Supply <onboarding@resend.dev>
WEB_APP_URL=http://localhost:3000

# LEGADO — não usada mais. O acesso administrativo agora é Role.ADMIN +
# JWT (mesmo login de cliente, ver /admin/entrar no site), não bearer
# token fixo. Mantida só porque apps/api/src/modules/admin/ não pôde ser
# apagada nesta sessão (sandbox negou); pode remover a pasta e esta linha
# juntas sem medo.
ADMIN_API_KEY=
