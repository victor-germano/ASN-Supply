# URL pública do site — usada em metadata (canonical, OG, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# URL base da API NestJS consumida pelo client e pelos server components
NEXT_PUBLIC_API_URL=http://localhost:3400/v1

# Segredo compartilhado com a API — MESMO valor de INTERNAL_API_KEY em
# apps/api/.env (32+ caracteres aleatórios). Sem ele, a API enxerga todos
# os visitantes do site como um só e o limite de requisições derruba a loja
# com pouco movimento. Nunca prefixar com NEXT_PUBLIC_ (iria pro navegador).
INTERNAL_API_KEY=

# Login social — mostra (ou não) o botão "Continuar com Google" em
# /entrar e /criar-conta. Precisa ser ligada manualmente aqui DEPOIS de
# configurar GOOGLE_OAUTH_CLIENT_ID/_SECRET do lado da API (são duas
# variáveis em dois apps porque uma é pública — o botão precisa saber se
# mostra ou não sem round-trip — e a outra é segredo real, nunca deveria
# ir pro bundle do client).
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=

# PIX — ligue (qualquer valor, ex: true) DEPOIS de preencher PIX_KEY na
# API. Controla o texto do checkout e o "Pix" no rodapé; o QR Code em si
# vem da API e só aparece se PIX_KEY estiver configurada lá.
NEXT_PUBLIC_PIX_ENABLED=

# Identificação legal no rodapé (ex: "CNPJ 12.345.678/0001-90"). Vazio =
# linha não aparece.
NEXT_PUBLIC_LEGAL_ID=

# Observability — sem NEXT_PUBLIC_SENTRY_DSN, o SDK não envia nada (mesmo
# projeto Sentry do lado da API, ou um separado — os dois funcionam).
NEXT_PUBLIC_SENTRY_DSN=
# Só usados no build de produção (upload de source maps) — se ausentes,
# essa etapa é pulada sem quebrar o build.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Analytics — Plausible (privacy-friendly, sem cookie/consentimento
# necessário). Sem NEXT_PUBLIC_PLAUSIBLE_DOMAIN, o script nem é
# renderizado (ver RootLayout). Troque por outro provedor se preferir —
# é só um <script> condicional, sem SDK/dependência nova.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
